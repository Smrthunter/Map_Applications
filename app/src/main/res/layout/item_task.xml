<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_liquid_card"
        android:padding="16dp">

        <View
            android:id="@+id/view_priority_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/ic_priority_dot"
            app:layout_constraintBottom_toBottomOf="@id/tv_task_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_task_title" />

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Task Title"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/checkbox_task"
            app:layout_constraintStart_toEndOf="@id/view_priority_dot"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_priority_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_priority_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="HIGH"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_task_title"
            app:layout_constraintTop_toBottomOf="@id/tv_task_title" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkbox_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_delete_task"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/ripple_liquid"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="@id/checkbox_task"
            app:layout_constraintTop_toBottomOf="@id/checkbox_task" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>